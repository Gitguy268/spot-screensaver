{
  "name": "spot-screensaver",
  "private": true,
  "version": "1.0.0",
  "description": "Spot naps, dreams and chases: a macOS screen saver and browser screensaver starring a black lab, in Three.js and in vector.",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build && node scripts/finish-build.mjs",
    "check-build": "node scripts/finish-build.mjs --check",
    "test": "npm run test:unit && npm run smoke",
    "test:unit": "node --test 'src/*.test.js'",
    "smoke": "node tests/smoke.mjs",
    "capture": "node scripts/capture.mjs",
    "saver": "bash macos/build.sh"
  },
  "dependencies": {
    "three": "0.187.0"
  },
  "devDependencies": {
    "imagetracerjs": "1.2.6",
    "playwright": "1.65.1",
    "pngjs": "7.0.0",
    "vite": "8.3.4",
    "vite-plugin-singlefile": "2.3.4"
  }
}
